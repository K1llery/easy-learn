{
  "manifest_version": 3,
  "name": "Easy Learn",
  "description": "英文技术文章与 PDF 伴读；选段解释、整页选择题测验、订阅账户直连、主动练习与本地复习。",
  "version": "0.16.0",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "contextMenus", "sidePanel", "identity"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "点击开启 / 关闭 Easy Learn 伴读",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "assets/*", "vocabulary/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  }
}
